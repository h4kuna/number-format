{
  "name": "h4kuna/number-format",
  "type": "library",
  "description": "Object wrapper above number_format",
  "homepage": "https://github.com/h4kuna/number-format",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-intl": "*",
    "h4kuna/data-type": "^3.0.5 || ^4.0"
  },
  "require-dev": {
    "nette/tester": "^2.4",
    "nette/utils": "^3.0 || ^4.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/coding-standard": "^0.2",
    "tracy/tracy": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\Format\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\Format\\Tests\\": "tests/src"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "suggest": {
    "ext-intl": "If you want to use IntlDateFormatter or NumberFormatter."
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/src",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/src"
  }
}
